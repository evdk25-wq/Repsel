{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Repsel",
  "version": "1.0.0",
  "identifier": "org.repsel.Repsel",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Repsel",
        "width": 800,
        "height": 600,
        "decorations": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self' customprotocol: asset:",
        "connect-src": "ipc: http://ipc.localhost",
        "font-src": "'self' data:",
        "img-src": "'self' asset: http://asset.localhost blob: data:",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'"
      },
      "devCsp": {
        "default-src": "'self' http://localhost:1420",
        "connect-src": "ipc: http://ipc.localhost ws://localhost:1420 ws://localhost:1421",
        "font-src": "'self' data:",
        "img-src": "'self' asset: http://asset.localhost blob: data:",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Repsel contributors",
    "category": "Productivity",
    "copyright": "Copyright © 2026 Repsel contributors",
    "license": "MIT",
    "licenseFile": "../LICENSE",
    "shortDescription": "A focused Markdown editor for Linux",
    "longDescription": "Repsel is a local-first Markdown editor for Linux with live formatting, mathematical notation and polished PDF export.",
    "linux": {
      "deb": {
        "section": "editors",
        "priority": "optional",
        "files": {
          "/usr/share/doc/repsel/copyright": "../LICENSE",
          "/usr/share/doc/repsel/README.md": "../README.md"
        }
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
